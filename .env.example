# Copia in .env (non committare .env). Qui solo i NOMI delle variabili, mai i valori reali.

# Progetto Supabase (valori dalla dashboard Supabase > Project Settings > API)
VITE_SUPABASE_URL=
# Chiave pubblica/anon (è pensata per il browser, ma resta comunque fuori dal repo)
VITE_SUPABASE_ANON_KEY=

# RandAI: lasciare vuoto o "false" finché è in pausa
VITE_FEATURE_RANDAI=false

# Solo per scripts/create-user.mjs, da usare in locale. MAI nel browser, MAI in Vercel/DigitalOcean come VITE_*
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
